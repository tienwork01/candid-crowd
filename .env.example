# CandidCrowd Environment Variables

# Public Contact Emails
NEXT_PUBLIC_SUPPORT_EMAIL=support@candidcrowd.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@candidcrowd.com
# Set this to https://candidcrowd.life when the host workspace is deployed
# on a separate subdomain (for example, host.candidcrowd.life).
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
BETTER_AUTH_DATABASE_URL=postgres://candidcrowd:replace-with-a-long-random-secret@localhost:5432/candidcrowd?options=-c%20search_path%3Dauth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Server-only key from Better Auth Infrastructure. Required to connect the
# deployed auth server to the Better Auth dashboard; never prefix with NEXT_PUBLIC_.
BETTER_AUTH_API_KEY=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_JWT_ISSUER=http://localhost:3000
BETTER_AUTH_JWT_AUDIENCE=candidcrowd-api
BETTER_AUTH_JWT_EXPIRATION=10m
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=CandidCrowd <no-reply@candidcrowd.local>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false
NEXT_PUBLIC_TERMS_VERSION=2026-01
NEXT_PUBLIC_PRIVACY_VERSION=2026-01
