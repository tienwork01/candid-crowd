# CandidCrowd Environment Variables

# Public App & Brand Configuration
NEXT_PUBLIC_APP_NAME=CandidCrowd
NEXT_PUBLIC_APP_TAGLINE=Shared memories for every event
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public Contact Emails
NEXT_PUBLIC_SUPPORT_EMAIL=support@candidcrowd.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@candidcrowd.com
# Set this to https://candidcrowd.life when the host workspace is deployed
# on a separate subdomain (for example, host.candidcrowd.life).
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
# Leave blank to call the same-origin HTTPS /api/v1 proxy. Do not put an HTTP
# API URL here when using `pnpm dev:https`, because browsers block mixed content.
NEXT_PUBLIC_API_BASE_URL=
# Server-only Gin upstream used by Next.js rewrites; never expose this as NEXT_PUBLIC.
API_UPSTREAM_URL=http://127.0.0.1:8080
# Client-side photo optimization runs before the direct R2 upload. It never
# touches video, preserves PNG/WebP type, and falls back to the original photo.
# 2560px + 90% JPEG quality preserves normal phone photo detail while usually
# reducing slow mobile uploads. Raise these values if full-resolution originals
# are more important than upload speed.
NEXT_PUBLIC_UPLOAD_IMAGE_MAX_DIMENSION=2560
NEXT_PUBLIC_UPLOAD_IMAGE_INITIAL_QUALITY=0.9
NEXT_PUBLIC_UPLOAD_IMAGE_COMPRESSION_MIN_BYTES=1048576
BETTER_AUTH_DATABASE_URL=postgres://candidcrowd:replace-with-a-long-random-secret@localhost:5432/candidcrowd?options=-c%20search_path%3Dauth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Server-only key from Better Auth Infrastructure. Required to connect the
# deployed auth server to the Better Auth dashboard; never prefix with NEXT_PUBLIC_.
BETTER_AUTH_API_KEY=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_JWT_ISSUER=http://localhost:3000
BETTER_AUTH_JWT_AUDIENCE=candidcrowd-api
BETTER_AUTH_JWT_EXPIRATION=10m
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=CandidCrowd <no-reply@candidcrowd.local>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false
NEXT_PUBLIC_TERMS_VERSION=2026-01
NEXT_PUBLIC_PRIVACY_VERSION=2026-01
# Set to true to test Service Worker registration & PWA installation prompts in dev mode.
# Keep false (or omit) during normal feature development to avoid service worker caching.
NEXT_PUBLIC_ENABLE_PWA_DEV=false
